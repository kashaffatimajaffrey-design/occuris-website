---
// Occuris Echo: one spoken sentence, what Echo did about it, and the approval
// it waits for. The card plays once when it scrolls into view (main.ts).
import ProductIntro from './ProductIntro.astro';
import { echo } from '../content/copy';
import '../styles/screens/echo.css';

interface Props {
  /** On the product's own page there is no "More" link */
  detail?: boolean;
}
const { detail = false } = Astro.props;
---
<section class="screen echo" id="echo" data-screen="paper" aria-labelledby="echo-title">
  <div class="wrap grid echo__grid">
    <div class="echo__text">
      <ProductIntro
        tag={echo.eyebrow}
        headline={echo.headline}
        titleId="echo-title"
        body={echo.body}
        points={echo.points}
        more={detail ? undefined : { href: '/echo', label: echo.more }}
      />
    </div>

    <figure class="echo__card" data-echo data-enter role="img" aria-label={echo.cardLabel}>
      <div class="echo__bar" aria-hidden="true">
        <span class="echo__mic"></span>
        <span class="echo__wave"><i></i><i></i><i></i><i></i><i></i><i></i><i></i></span>
        <span class="echo__state" data-heard={echo.heard}>{echo.listening}</span>
      </div>
      <p class="echo__said" aria-hidden="true">{echo.said}</p>
      <ol class="echo__steps" aria-hidden="true">
        {echo.steps.map((s) => (
          <li class:list={['echo__step', { 'echo__step--wait': s.wait }]}>
            <span class="echo__time">{s.time}</span>
            <span class="echo__what">{s.wait && <span class="echo__amber" />}{s.text}</span>
          </li>
        ))}
      </ol>
    </figure>
  </div>
</section>
