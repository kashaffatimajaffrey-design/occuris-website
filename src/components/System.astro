---
// "How it fits together": the three products as one loop. Every part of the
// diagram can be hovered, focused or tapped to open a card that shows, with a
// small animation, what that layer does: what, when, how and why. Two layouts
// of the same drawing: left to right on wide screens, top to bottom on phones.
import Headline from './Headline.astro';
import { system } from '../content/copy';
import '../styles/screens/system.css';

const { inputs, parts, outputs, cards, rows } = system;
type Key = keyof typeof cards;
const inKeys: Key[] = ['whatsapp', 'spreadsheets', 'email', 'erp'];
const partKeys: Key[] = ['occuralog', 'command', 'echo'];
const outKeys: Key[] = ['alerts', 'approvals', 'reports'];
const allKeys: Key[] = [...inKeys, ...partKeys, ...outKeys];
const label = (k: Key) => `${cards[k].title}: ${cards[k].kind}`;

// ---- wide: 1200 x 400 ----
const W = { boxW: 232, boxH: 120, cy: 200, xs: [222, 496, 770], inX: 86, outX: 1116, pillW: 124, pillH: 32 };
const inY = inputs.map((_, i) => 110 + i * 60);
const outY = outputs.map((_, i) => 130 + i * 70);
const wIn = inY.map((y) => `M${W.inX + W.pillW / 2},${y} C190,${y} 200,${W.cy} ${W.xs[0]},${W.cy}`);
const wOut = outY.map((y) => `M${W.xs[2] + W.boxW},${W.cy} C1030,${W.cy} 1024,${y} ${W.outX - W.pillW / 2 - 4},${y}`);
const wideDot = `M${W.inX + W.pillW / 2},${inY[1]} C190,${inY[1]} 200,${W.cy} ${W.xs[0]},${W.cy} L${W.xs[2] + W.boxW},${W.cy} C1030,${W.cy} 1024,${outY[0]} ${W.outX - W.pillW / 2},${outY[0]}`;

// ---- tall: 360 x 720 ----
const T = { boxW: 260, boxH: 96, cx: 180, ys: [178, 336, 494], pillW: 150, pillH: 30 };
const tallIn = inputs.map((_, i) => [i % 2 ? 268 : 92, 40 + Math.floor(i / 2) * 44] as const);
const tallOut = outputs.map((_, i) => [62 + i * 118, 672] as const);
const tIn = tallIn.map(([x, y]) => `M${x},${y + T.pillH / 2} C${x},140 ${T.cx},140 ${T.cx},${T.ys[0]}`);
const tOut = tallOut.map(([x, y]) => `M${T.cx},${T.ys[2] + T.boxH} C${T.cx},630 ${x},620 ${x},${y - T.pillH / 2 - 3}`);
const tallDot = `M${tallIn[0][0]},${tallIn[0][1] + T.pillH / 2} C${tallIn[0][0]},140 ${T.cx},140 ${T.cx},${T.ys[0]} L${T.cx},${T.ys[2] + T.boxH} C${T.cx},630 ${tallOut[0][0]},620 ${tallOut[0][0]},${tallOut[0][1] - T.pillH / 2}`;

const layouts = [
  { id: 'w', cls: 'sys__svg--wide', box: '0 0 1200 400', inPaths: wIn, outPaths: wOut, dot: wideDot },
  { id: 't', cls: 'sys__svg--tall', box: '0 0 360 720', inPaths: tIn, outPaths: tOut, dot: tallDot },
];
---
<section class="screen sys" id="system" data-screen="paper" aria-labelledby="sys-title">
  <div class="wrap">
    <div class="sys__head">
      <p class="tag"><span class="tag__ring" aria-hidden="true"></span>{system.eyebrow}</p>
      <Headline id="sys-title" lines={system.headline} class="sys__title" />
      <p class="sys__body" data-reveal>{system.body}</p>
    </div>

    <figure class="sys__figure" data-enter data-system aria-label={system.diagramLabel}>
      {layouts.map((L) => (
        <svg class:list={['sys__svg', L.cls]} viewBox={L.box}>
          <defs>
            <marker id={`sys-arrow-${L.id}`} viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
              <path class="sys__arrowhead" d="M0,0 L10,5 L0,10 z" />
            </marker>
          </defs>

          {L.id === 'w' ? (
            <Fragment>
              <rect class="sys__frame" x={W.xs[0] - 28} y="96" width={W.xs[2] + W.boxW - W.xs[0] + 56} height="208" />
              <text class="sys__frame-label" x={W.xs[0] - 16} y="100">{system.frame}</text>
              <path class="sys__link sys__link--main" data-a="occuralog" data-b="command" d={`M${W.xs[0] + W.boxW},${W.cy} L${W.xs[1] - 6},${W.cy}`} marker-end={`url(#sys-arrow-${L.id})`} />
              <path class="sys__link sys__link--main" data-a="command" data-b="echo" d={`M${W.xs[1] + W.boxW},${W.cy} L${W.xs[2] - 6},${W.cy}`} marker-end={`url(#sys-arrow-${L.id})`} />
            </Fragment>
          ) : (
            <Fragment>
              <rect class="sys__frame" x={T.cx - T.boxW / 2 - 18} y={T.ys[0] - 22} width={T.boxW + 36} height={T.ys[2] + T.boxH - T.ys[0] + 44} />
              <text class="sys__frame-label" x={T.cx - T.boxW / 2 - 8} y={T.ys[0] - 18}>{system.frame}</text>
              <path class="sys__link sys__link--main" data-a="occuralog" data-b="command" d={`M${T.cx},${T.ys[0] + T.boxH} L${T.cx},${T.ys[1] - 6}`} marker-end={`url(#sys-arrow-${L.id})`} />
              <path class="sys__link sys__link--main" data-a="command" data-b="echo" d={`M${T.cx},${T.ys[1] + T.boxH} L${T.cx},${T.ys[2] - 6}`} marker-end={`url(#sys-arrow-${L.id})`} />
            </Fragment>
          )}
          {L.inPaths.map((d, i) => <path id={`sys-in-${L.id}-${i}`} class="sys__link sys__link--in" data-a={inKeys[i]} data-b="occuralog" d={d} />)}
          {L.outPaths.map((d, i) => <path id={`sys-out-${L.id}-${i}`} class="sys__link sys__link--out" data-a="echo" data-b={outKeys[i]} d={d} />)}

          <!-- traffic: a violet dot down each input, an ink dot out to each output, one amber dot through it all -->
          {L.inPaths.map((_, i) => (
            <circle class="sys__packet" r="3.5">
              <animateMotion dur="2.6s" begin={`${i * 0.65}s`} repeatCount="indefinite"><mpath href={`#sys-in-${L.id}-${i}`} /></animateMotion>
            </circle>
          ))}
          {L.outPaths.map((_, i) => (
            <circle class="sys__packet sys__packet--out" r="3">
              <animateMotion dur="2.2s" begin={`${1 + i * 0.7}s`} repeatCount="indefinite"><mpath href={`#sys-out-${L.id}-${i}`} /></animateMotion>
            </circle>
          ))}
          <circle class="sys__dot" r="5.5">
            <animateMotion dur="7s" repeatCount="indefinite" path={L.dot} />
          </circle>

          {inputs.map((s, i) => {
            const [x, y] = L.id === 'w' ? [W.inX, inY[i]] : tallIn[i];
            const pw = L.id === 'w' ? W.pillW : T.pillW;
            const ph = L.id === 'w' ? W.pillH : T.pillH;
            return (
              <g class="sys__node sys__pill" data-node={inKeys[i]} transform={`translate(${x} ${y})`} tabindex="0" role="button" aria-label={label(inKeys[i])} aria-expanded="false">
                <g class="sys__lift">
                  <rect x={-pw / 2} y={-ph / 2} width={pw} height={ph} rx={ph / 2} />
                  <text y="1">{s}</text>
                </g>
              </g>
            );
          })}
          {parts.map((p, i) => {
            const bw = L.id === 'w' ? W.boxW : T.boxW;
            const bh = L.id === 'w' ? W.boxH : T.boxH;
            const pos = L.id === 'w' ? `translate(${W.xs[i]} ${W.cy - W.boxH / 2})` : `translate(${T.cx - T.boxW / 2} ${T.ys[i]})`;
            const nameY = L.id === 'w' ? (i === 1 ? 44 : 52) : i === 1 ? 36 : 42;
            return (
              <g class="sys__node sys__box" data-node={partKeys[i]} transform={pos} tabindex="0" role="button" aria-label={label(partKeys[i])} aria-expanded="false">
                <g class="sys__lift">
                  <rect width={bw} height={bh} rx="8" />
                  <text class="sys__name" x={bw / 2} y={nameY}>{p.name}</text>
                  <text class="sys__line" x={bw / 2} y={nameY + 26}>{p.line}</text>
                  {i === 1 && [0, 1, 2, 3, 4, 5].map((k) => <circle class="sys__agent" style={`--k:${k}`} cx={bw / 2 - 40 + k * 16} cy={nameY + 50} r="3.5" />)}
                  <text class="sys__more" x={bw - 14} y="22">+</text>
                </g>
              </g>
            );
          })}
          {outputs.map((s, i) => {
            const [x, y] = L.id === 'w' ? [W.outX, outY[i]] : tallOut[i];
            const pw = L.id === 'w' ? W.pillW : 108;
            const ph = L.id === 'w' ? W.pillH : T.pillH;
            return (
              <g class="sys__node sys__pill sys__pill--out" data-node={outKeys[i]} transform={`translate(${x} ${y})`} tabindex="0" role="button" aria-label={label(outKeys[i])} aria-expanded="false">
                <g class="sys__lift">
                  <rect x={-pw / 2} y={-ph / 2} width={pw} height={ph} rx={ph / 2} />
                  <text y="1">{s}</text>
                </g>
              </g>
            );
          })}
        </svg>
      ))}

      <!-- One card per part; main.ts shows the one you point at -->
      {allKeys.map((k) => {
        const c = cards[k];
        return (
          <div class="sys__card" data-card={k} role="dialog" aria-label={c.title} hidden>
            <button class="sys__close" type="button" data-card-close aria-label={system.close}>×</button>
            <div class:list={['viz', `viz--${k}`]} aria-hidden="true">
              {k === 'whatsapp' && (
                <Fragment>
                  <span class="viz__b">truck late hai <i>✓✓</i></span>
                  <span class="viz__b">3 container ruke <i>✓✓</i></span>
                  <span class="viz__b">stock khatam <i>✓✓</i></span>
                </Fragment>
              )}
              {k === 'spreadsheets' && (
                <div class="viz__grid">
                  <span></span><span>A</span><span>B</span>
                  <span>4</span><span>bags</span><span>120</span>
                  <span>5</span><span>cartons</span><span class="viz__flip"><b>230</b><b>30</b></span>
                  <span>6</span><span>pallets</span><span>14</span>
                </div>
              )}
              {k === 'email' && (
                <Fragment>
                  <span class="viz__mail"><i></i>Re: PO-1187 lead time</span>
                  <span class="viz__mail"><i></i>Re: Re: PO-1187 lead time</span>
                  <span class="viz__mail viz__mail--new"><i></i>Re: Re: Re: PO-1187 lead time</span>
                </Fragment>
              )}
              {k === 'erp' && (
                <Fragment>
                  <span class="viz__row"><b>PO-1187</b> 400 cartons <em>open</em></span>
                  <span class="viz__row"><b>BOM-22</b> copper wire <em>12 lines</em></span>
                  <span class="viz__row"><b>SO-3410</b> Sukkur <em>due Thu</em></span>
                </Fragment>
              )}
              {k === 'occuralog' && (
                <div class="viz__morph">
                  <span class="viz__b viz__b--src">truck late hai, 200 carton kal</span>
                  <span class="viz__arrow">↓</span>
                  <span class="viz__chip"><b>Cartons</b><b>200</b><b>ETA tomorrow</b><b>0.94</b></span>
                </div>
              )}
              {k === 'command' && (
                <div class="viz__agents">
                  <div>{[0, 1, 2, 3, 4, 5].map((n) => <i style={`--k:${n}`}></i>)}</div>
                  <span class="viz__caption">Inventory: 30 cartons left, reorder raised</span>
                </div>
              )}
              {k === 'echo' && (
                <div class="viz__voice">
                  <span class="viz__mic"></span>
                  <span class="viz__wave">{[0, 1, 2, 3, 4, 5, 6, 7, 8].map((n) => <i style={`--k:${n}`}></i>)}</span>
                  <span class="viz__said">“Approve the reorder”</span>
                </div>
              )}
              {k === 'alerts' && (
                <div class="viz__alert">
                  <span class="viz__flag"></span>
                  <span class="viz__type">Customs hold: line stops in 4 days</span>
                </div>
              )}
              {k === 'approvals' && (
                <div class="viz__approve">
                  <span>Reorder 400 cartons</span>
                  <span class="viz__btn"><svg viewBox="0 0 16 16"><path d="M3 8.5 L6.5 12 L13 4.5" /></svg>Approve</span>
                </div>
              )}
              {k === 'reports' && (
                <div class="viz__bars">
                  <div>{[44, 70, 32, 86, 58].map((h, n) => <i style={`--h:${h}%;--k:${n}`}></i>)}</div>
                  <span class="viz__caption">8 records · 6 decisions</span>
                </div>
              )}
            </div>
            <p class="sys__card-kind">{c.kind}</p>
            <h3 class="sys__card-title">{c.title}</h3>
            <dl class="sys__rows">
              <div><dt>{rows.what}</dt><dd>{c.what}</dd></div>
              <div><dt>{rows.when}</dt><dd>{c.when}</dd></div>
              <div><dt>{rows.how}</dt><dd>{c.how}</dd></div>
              <div><dt>{rows.why}</dt><dd>{c.why}</dd></div>
            </dl>
          </div>
        );
      })}
    </figure>

    <p class="sys__hint"><span aria-hidden="true"></span>{system.hint}</p>
    <p class="sys__note">{system.note}</p>
  </div>
</section>
