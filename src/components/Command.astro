---
import ProductIntro from './ProductIntro.astro';
import { command } from '../content/copy';
import '../styles/screens/command.css';

interface Props {
  /** On the product's own page there is no "More" link */
  detail?: boolean;
}
const { detail = false } = Astro.props;
---
<section class="screen screen--night cmd" id="command" data-screen="night" aria-labelledby="cmd-title">
  <div class="wrap cmd__inner">
    <div class="cmd__head">
      <ProductIntro
        tag={command.eyebrow}
        headline={command.headline}
        titleId="cmd-title"
        body={command.body}
        points={command.outcomes}
        more={detail ? undefined : { href: '/command', label: command.more }}
        night
      />
    </div>

    <div
      class="cmd__diagram"
      data-piece="flow-diagram"
      data-enter
      data-flow={JSON.stringify({ sources: command.sources, agents: command.agents, outputs: command.outputs, core: command.core, feeds: command.feeds })}
      role="img"
      aria-label={command.diagramLabel}
    ></div>

    <div class="log" aria-hidden="true" data-strip data-alerts={JSON.stringify(command.alerts)} data-tz={command.timezone} data-tz-label={command.timezoneLabel}>
      <p class="log__prev mono" data-strip-prev aria-hidden="true"></p>
      <p class="log__now mono">
        <span class="log__meta"><span data-strip-time>--:--:--</span> <span data-strip-agent></span></span>
        <span class="log__line"><span data-strip-text></span><span class="log__caret" aria-hidden="true"></span></span>
      </p>
    </div>
    <ul class="sr-only">
      {command.alerts.map((a) => <li>{a.text}</li>)}
    </ul>
  </div>
</section>
