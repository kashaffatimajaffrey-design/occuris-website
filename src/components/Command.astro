---
import ProductIntro from './ProductIntro.astro';
import InfoCard from './InfoCard.astro';
import { command, system } from '../content/copy';
import '../styles/screens/command.css';

interface Props {
  /** On the product's own page there is no "More" link */
  detail?: boolean;
}
const { detail = false } = Astro.props;
const { keys } = command;
// Sources and outputs are the same parts as in System, so they share its cards
const shared = [...keys.sources, ...keys.outputs] as (keyof typeof system.cards)[];
---
<section class="screen screen--night cmd" id="command" data-screen="night" aria-labelledby="cmd-title">
  <div class="wrap cmd__inner">
    <div class="cmd__head">
      <ProductIntro
        tag={command.eyebrow}
        headline={command.headline}
        titleId="cmd-title"
        body={command.body}
        points={command.outcomes}
        more={detail ? undefined : { href: '/command', label: command.more }}
        night
      />
    </div>

    <figure class="cmd__fig" data-cards data-enter>
      <div
        class="cmd__diagram"
        data-piece="flow-diagram"
        data-flow={JSON.stringify({ sources: command.sources, agents: command.agents, outputs: command.outputs, core: command.core, feeds: command.feeds, keys })}
        role="group"
        aria-label={command.diagramLabel}
      ></div>
      <!-- One card per part; main.ts shows the one you point at -->
      {shared.map((k) => <InfoCard id={k} viz={k} {...system.cards[k]} rows={system.rows} close={system.close} />)}
      <InfoCard id={keys.core} viz="data" {...command.cards.data} rows={system.rows} close={system.close} />
      {keys.agents.map((k, i) => (
        <InfoCard id={k} viz="agent" agent={i} {...command.cards[k as keyof typeof command.cards]} rows={system.rows} close={system.close} />
      ))}
      <figcaption class="cmd__hint">{command.hint}</figcaption>
    </figure>

    <div class="log" aria-hidden="true" data-strip data-alerts={JSON.stringify(command.alerts)} data-tz={command.timezone} data-tz-label={command.timezoneLabel}>
      <p class="log__prev mono" data-strip-prev aria-hidden="true"></p>
      <p class="log__now mono">
        <span class="log__meta"><span data-strip-time>--:--:--</span> <span data-strip-agent></span></span>
        <span class="log__line"><span data-strip-text></span><span class="log__caret" aria-hidden="true"></span></span>
      </p>
    </div>
    <ul class="sr-only">
      {command.alerts.map((a) => <li>{a.text}</li>)}
    </ul>
  </div>
</section>
