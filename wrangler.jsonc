// Cloudflare Workers deploy: the site is plain static files, served from
// ./dist by Workers static assets. public/_headers is honoured as-is.
{
  "name": "occuris-website",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./dist"
  }
}
